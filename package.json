{
  "name": "kavach-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Kavach AI - Independent AI-powered work intelligence and protection layer for gig workers",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"api,ui\" -c \"blue,green\" \"npm run dev:api\" \"npm run dev:ui\"",
    "dev:ui": "vite",
    "dev:api": "tsx watch src/api/mock-server.ts",
    "build": "tsc -b && vite build",
    "build:lambda": "esbuild src/api/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist-lambda/index.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1134.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1134.0",
    "@aws-sdk/client-dynamodb": "^3.1134.0",
    "@aws-sdk/client-s3": "^3.1134.0",
    "@aws-sdk/credential-provider-node": "^3.972.83",
    "@aws-sdk/lib-dynamodb": "^3.1134.0",
    "@smithy/hash-node": "^4.5.2",
    "@types/aws-lambda": "^8.10.163",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "openai": "^7.17.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.5",
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "dotenv": "^16.4.5",
    "esbuild": "^0.28.2",
    "eslint": "^9.10.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.6",
    "vitest": "^2.1.1"
  }
}
