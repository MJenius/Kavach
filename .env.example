# ==============================================================================
# Kavach AI Environment Configuration
# ==============================================================================
# Mode Flags (Mock-first by default: zero cloud credentials needed for local development)
MOCK_AWS=true
MOCK_AI=true
MOCK_AUTH=true

# Server / Local API Configuration
PORT=3001
API_BASE_URL=http://localhost:3001/api
VITE_API_URL=http://localhost:3001/api

# AWS Deployment Configuration (Target Cloud - Person 3)
AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
DYNAMODB_TABLE_PREFIX=kavach-
S3_EVIDENCE_BUCKET=kavach-evidence-bucket
STEP_FUNCTIONS_CASE_ARN=
EVENTBRIDGE_BUS_NAME=kavach-events

# Amazon Bedrock Configuration (AI Layer - Person 1 & Person 3)
# Primary production mode uses Bedrock Mantle OpenAI-compatible API
BEDROCK_MANTLE_BASE_URL=https://bedrock-mantle.ap-south-1.api.aws/v1
BEDROCK_MODEL_ID=openai.gpt-oss-120b
BEDROCK_API_KEY=
# Optional Claude fallback
# BEDROCK_PROVIDER=bedrock-claude
# BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Cedar / Authorization Configuration
CEDAR_POLICY_STORE_ID=

